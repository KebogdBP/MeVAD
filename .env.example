# Runtime paths are resolved from PATH by default.
MEVAD_FFMPEG_PATH=
MEVAD_FFPROBE_PATH=

# API
MEVAD_ENVIRONMENT=development
MEVAD_API_HOST=127.0.0.1
MEVAD_API_PORT=8000
MEVAD_API_DOCS_ENABLED=true
MEVAD_REQUIRE_MEDIA_TOOLS=true

# Keep disabled until the API runs behind an SSRF-safe network boundary.
MEVAD_ANALYZER_ENABLED=false
