# Runtime paths are resolved from PATH by default.
MEVAD_FFMPEG_PATH=
MEVAD_FFPROBE_PATH=

# API
MEVAD_ENVIRONMENT=development
MEVAD_API_HOST=127.0.0.1
MEVAD_API_PORT=8000
MEVAD_API_DOCS_ENABLED=true
MEVAD_REQUIRE_MEDIA_TOOLS=true
MEVAD_JOB_BACKEND=memory
MEVAD_QUEUE_BACKEND=memory
MEVAD_DATABASE_URL=postgresql+psycopg://mevad:mevad@localhost:5432/mevad
MEVAD_REDIS_URL=redis://localhost:6379/0
MEVAD_REDIS_QUEUE_NAME=mevad:jobs
MEVAD_AUTO_CREATE_SCHEMA=false
MEVAD_WORKER_POLL_TIMEOUT_SECONDS=5
MEVAD_WORKER_MEDIA_TIMEOUT_SECONDS=7200
MEVAD_WORKER_CPU_LIMIT_SECONDS=7200
MEVAD_WORKER_MEMORY_LIMIT_BYTES=2147483648
MEVAD_WORKER_FILE_SIZE_LIMIT_BYTES=10737418240
MEVAD_WORKER_OPEN_FILES_LIMIT=256
MEVAD_WORKER_LEASE_SECONDS=60
MEVAD_WORKER_HEARTBEAT_SECONDS=15
MEVAD_WORKER_RECOVERY_INTERVAL_SECONDS=30
MEVAD_WORKER_CLAIM_STALE_SECONDS=120
MEVAD_WORKER_RETRY_BASE_SECONDS=5
MEVAD_WORKER_RETRY_MAX_SECONDS=300
MEVAD_OUTBOX_POLL_INTERVAL_SECONDS=1
MEVAD_OUTBOX_LEASE_SECONDS=30
MEVAD_OUTBOX_BATCH_SIZE=100
MEVAD_JOB_MAX_ATTEMPTS=3
MEVAD_STORAGE_ROOT=storage/jobs
MEVAD_STORAGE_RETENTION_SECONDS=86400
MEVAD_CLEANUP_POLL_INTERVAL_SECONDS=60
MEVAD_CLEANUP_LEASE_SECONDS=300
MEVAD_CLEANUP_BATCH_SIZE=100

# Enable only together with the external proxy sandbox.
MEVAD_ANALYZER_ENABLED=false
MEVAD_NETWORK_SANDBOX=disabled
MEVAD_MEDIA_PROXY_URL=

# Public canonical origin for Next.js metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://mevad.app
