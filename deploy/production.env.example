# Copy to an untracked production.env and provide it with --env-file.
MEVAD_DOMAIN=mevad.example.com
NEXT_PUBLIC_SITE_URL=https://mevad.example.com
MEVAD_POSTGRES_PASSWORD=replace-with-a-long-random-secret
MEVAD_DATABASE_URL=postgresql+psycopg://mevad:URL_ENCODED_PASSWORD@postgres:5432/mevad

# Keep disabled until the Privacy Notice names the provider and retention.
NEXT_PUBLIC_MEVAD_TELEMETRY_ENABLED=false
MEVAD_TELEMETRY_MODE=off
MEVAD_STORAGE_RETENTION_SECONDS=86400

# Paste only the verification token, not the complete meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
